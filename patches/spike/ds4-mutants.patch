diff --git a/riscv/act_mutant.h b/riscv/act_mutant.h
new file mode 100644
index 0000000..220a7ad
--- /dev/null
+++ b/riscv/act_mutant.h
@@ -0,0 +1,19 @@
+// ACT4 D S4 mutants. Select with SPIKE_MUTANT=M1|M2|M3|M4 (unset = normal Spike).
+#ifndef ACT_MUTANT_H
+#define ACT_MUTANT_H
+#include <cstdlib>
+#include <cstring>
+static inline bool act_mutant(const char* id)
+{
+  static const char* m = std::getenv("SPIKE_MUTANT");
+  return m && std::strcmp(m, id) == 0;
+}
+// M1: decoder only accepts rm=000 on exact conversions (as if MASK included bits 14:12)
+#define MUT_M1_STRICT_DECODE() \
+  do { if (act_mutant("M1") && insn.rm() != 0) throw trap_illegal_instruction(insn.bits()); } while (0)
+// M2: rm field is never checked (reserved static rm 101/110 executes)
+// M4: dynamic rm ignores a reserved frm (frm=5..7 executes)
+#define MUT_RM() \
+  (act_mutant("M2") ? 0 : \
+   act_mutant("M4") && insn.rm() == 7 ? (STATE.frm->read() & 3) : RM)
+#endif
