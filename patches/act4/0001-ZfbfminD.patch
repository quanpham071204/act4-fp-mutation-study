diff --git a/coverpoints/norm/Zfbfmin.yaml b/coverpoints/norm/Zfbfmin.yaml
index 31e8570..4edfeaa 100644
--- a/coverpoints/norm/Zfbfmin.yaml
+++ b/coverpoints/norm/Zfbfmin.yaml
@@ -12,23 +12,37 @@ normative_rule_definitions:
     coverpoint:
       [
         "{Zfbfmin_fcvt_bf16_s_cg, Zfbfmin_flh_cg, Zfbfmin_fmv_h_x_cg}/cp_NaNBox_S_H",
+        "{ZfbfminD_fcvt_bf16_s_cg, ZfbfminD_flh_cg, ZfbfminD_fmv_h_x_cg}/cp_NaNBox_D_H",
       ]
   # A narrower n-bit transfer, n&lt;FLEN, into the f registers will create a valid
   # NaN-boxed value
   - name: fp_transfer_instrs_narrow_transfer_in
-    coverpoint: ["{Zfbfmin_flh_cg, Zfbfmin_fmv_h_x_cg}/cp_NaNBox_S_H"]
+    coverpoint:
+      [
+        "{Zfbfmin_flh_cg, Zfbfmin_fmv_h_x_cg}/cp_NaNBox_S_H",
+        "{ZfbfminD_flh_cg, ZfbfminD_fmv_h_x_cg}/cp_NaNBox_D_H",
+      ]
   # A narrower n-bit transfer out of the floating-point registers will transfer the
   # lower n bits of the register ignoring the upper FLEN-n bits
   - name: fp_transfer_instrs_narrow_transfer_out
     coverpoint:
-      ["Zfbfmin_fmv_x_h_cg/cp_fs1_badNB_S_H", "Zfbfmin_fsh_cg/cp_fs2_badNB_S_H"]
+      [
+        "Zfbfmin_fmv_x_h_cg/cp_fs1_badNB_S_H",
+        "Zfbfmin_fsh_cg/cp_fs2_badNB_S_H",
+        "ZfbfminD_fmv_x_h_cg/cp_fs1_badNB_D_H",
+        "ZfbfminD_fsh_cg/cp_fs2_badNB_D_H",
+      ]
   # Apart from transfer operations described in the previous paragraph, all other
   # floating-point operations on narrower n-bit operations, n&lt;FLEN, check if the
   # input operands are correctly NaN-boxed, i.e., all upper FLEN-n bits are 1. If so,
   # the n least-significant bits of the input are used as the input value, otherwise the
   # input value is treated as an n-bit canonical NaN.
   - name: fp_nontransfer_instrs_improper_nan_boxed_input
-    coverpoint: ["Zfbfmin_fcvt_s_bf16_cg/cp_fs1_badNB_S_H"]
+    coverpoint:
+      [
+        "Zfbfmin_fcvt_s_bf16_cg/cp_fs1_badNB_S_H",
+        "ZfbfminD_fcvt_s_bf16_cg/cp_fs1_badNB_D_H",
+      ]
   # New 16-bit variants of LOAD-FP and STORE-FP instructions are added, encoded with a
   # new value for the funct3 width field.
   - name: fsh_flh_op
@@ -38,13 +52,20 @@ normative_rule_definitions:
   # representation in the IEEE 754-2008 encoding in integer register rd, filling the
   # upper XLEN-16 bits with copies of the floating-point number's sign bit
   - name: fmv-x-h_op
-    coverpoint: ["Zfbfmin_fmv_x_h_cg/{cp_rd, cp_fs1, cp_fs1_edges_H}"]
+    coverpoint:
+      [
+        "Zfbfmin_fmv_x_h_cg/{cp_rd, cp_fs1, cp_fs1_edges_H}",
+        "ZfbfminD_fmv_x_h_cg/cp_fs1_badNB_D_H",
+      ]
   # insn:fmv.h.x[] moves the half-precision value encoded in the IEEE 754-2008 encoding
   # from the lower 16 bits of integer register rs1 to the floating-point register rd,
   # NaN-boxing the result.
   - name: fmv-h-x_op
     coverpoint:
-      ["Zfbfmin_fmv_h_x_cg/{cp_rs1, cp_rs1_edges, cp_fd, cp_NaNBox_S_H}"]
+      [
+        "Zfbfmin_fmv_h_x_cg/{cp_rs1, cp_rs1_edges, cp_fd, cp_NaNBox_S_H}",
+        "ZfbfminD_fmv_h_x_cg/cp_NaNBox_D_H",
+      ]
   # BF16 computational instructions defined in this chapter support all IEEE 754-2008
   # features, including all rounding modes, subnormal inputs and outputs, overflow and
   # underflow, and default exception handling. Tininess is detected after rounding.
@@ -59,8 +80,14 @@ normative_rule_definitions:
   # Narrowing convert FP32 value to a BF16 value. Round according to the RM field.
   - name: fcvt-bf16-s_op
     coverpoint:
-      ["Zfbfmin_fcvt_bf16_s_cg/{cp_fd, cp_fs1_edges, cp_frm_2, cp_csr_frm}"]
+      [
+        "Zfbfmin_fcvt_bf16_s_cg/{cp_fd, cp_fs1_edges, cp_frm_2, cp_csr_frm}",
+        "ZfbfminD_fcvt_bf16_s_cg/cp_NaNBox_D_H",
+      ]
   # Converts a BF16 value to an FP32 value. The conversion is exact.
   - name: fcvt-s-bf16_op
     coverpoint:
-      ["Zfbfmin_fcvt_s_bf16_cg/{cp_fd, cp_fs1_edges_BF16, cp_csr_fflags_v}"]
+      [
+        "Zfbfmin_fcvt_s_bf16_cg/{cp_fd, cp_fs1_edges_BF16, cp_csr_fflags_v}",
+        "ZfbfminD_fcvt_s_bf16_cg/cp_fs1_badNB_D_H",
+      ]
