+
+  # ---------------------------------------------------------------- U params
+  # BigEndianEn = 0, so MBE/SBE/UBE are read-only zero (https://github.com/openhwfoundation/cva6/blob/81245a47fad8fe1a5d562d953ef2662e099def76/core/csr_regfile.sv#L1647-L1649)
+  U_MODE_ENDIANNESS: little
+  # WFI in U-mode raises an illegal-instruction exception (https://github.com/openhwfoundation/cva6/blob/81245a47fad8fe1a5d562d953ef2662e099def76/core/decoder.sv#L290-L293)
+  WFI_U_MODE: false
